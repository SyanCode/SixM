# Serveur SixM hébergé sans interface (Mas, Docker…). Toutes facultatives : server.json donne le reste.
# Le port vient de PORT (donné par la plateforme) ou de SIXM_PORT.

# Nom affiché dans la liste des serveurs, et mot de passe (vide : ouvert)
SIXM_NAME=
SIXM_PASSWORD=
SIXM_MAX_PLAYERS=

# public : annoncé ; private : seulement par adresse. Liste blanche : 1 pour n'accepter que les joueurs acceptés.
SIXM_VISIBILITY=
SIXM_WHITELIST=

# Derrière nginx (Mas) : 1, pour bannir la vraie adresse du joueur et pas celle du proxy
SIXM_TRUST_PROXY=

# Dossier gardé entre les déploiements, pour bans.json et access.json (ex. /srv/mas/apps/sixm/.home/data)
SIXM_DATA_DIR=

# Identifiants des administrateurs (« Copier mon identifiant » dans SixM), séparés par des virgules
SIXM_ADMINS=
