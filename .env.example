# Serveur SixM hébergé sans interface (Mas, Docker…). server.json donne le reste ; le port vient de PORT ou SIXM_PORT.

# Nom affiché dans la liste des serveurs
SIXM_NAME=Serveur SixM

# Nombre de joueurs au plus
SIXM_MAX_PLAYERS=32

# public : annoncé ; private : seulement par adresse
SIXM_VISIBILITY=public

# 1 : seuls les joueurs acceptés par un admin entrent
SIXM_WHITELIST=0

# Derrière nginx (Mas) : 1, pour voir et bannir la vraie adresse des joueurs
SIXM_TRUST_PROXY=1

# Dossier gardé entre les déploiements, pour bans.json et access.json
SIXM_DATA_DIR=/srv/mas/apps/sixm/.home/data

# Mot de passe du serveur (vide : ouvert à tous)
# SIXM_PASSWORD=

# Identifiants des administrateurs (« Copier mon identifiant » dans SixM), séparés par des virgules
# SIXM_ADMINS=
